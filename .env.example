# =============================================================================
# Later — configuration
# =============================================================================
#
#   cp .env.example .env
#
# Every variable is documented inline. Required ones are marked [REQUIRED].
# Everything else has a working default — you can ignore it until you need it.
#
# This file is committed and contains no secrets. Your `.env` is gitignored and
# must never be committed. CI scans the full git history for secrets on every
# push.
#
# Where the values come from: docs/ACTION-REQUIRED.md
# =============================================================================


# -----------------------------------------------------------------------------
# Mode and identity
# -----------------------------------------------------------------------------

# SOLO  — one user. The first person to complete OAuth claims the instance and
#         every later attempt is refused, so nobody who finds your URL can
#         attach their account. This is what you want.
# MULTI — several users, each doing their own OAuth. Requires
#         LATER_ALLOWED_EMAILS below. Each person gets their own playlist and
#         mints their own ingest token from the web UI, so INGEST_TOKEN is
#         ignored. All users share ONE Google Cloud project's 10,000-unit daily
#         quota — see docs/adr/0013-solo-and-multi-modes.md
LATER_MODE=SOLO

# MULTI only. Comma-separated allowlist of Google account emails permitted to
# authorise. Startup refuses to run in MULTI with this empty — an open
# registration endpoint that writes to YouTube playlists is not a default
# anyone should be able to trip over.
LATER_ALLOWED_EMAILS=

# The public origin this instance is reachable at. No trailing slash.
# Used to build OAuth redirect URIs, re-auth links, and the PWA manifest, so
# it must match a redirect URI registered on your OAuth client exactly.
# The port Later listens on is taken from this URL, so changing the port here is
# how you change the port — no separate setting. (PORT overrides it if set.)
#   local, any target : http://localhost:8787
#   deployed          : https://later.<your-subdomain>.workers.dev
PUBLIC_BASE_URL=http://localhost:8787

# info | debug | warn | error
LOG_LEVEL=info


# -----------------------------------------------------------------------------
# The destination playlist
# -----------------------------------------------------------------------------
#
# IMPORTANT: this is NOT your native YouTube "Watch Later" queue. Google removed
# API access to Watch Later on 12 September 2016 and there is no way to write to
# it. Later creates and writes to a normal playlist you own.
# See docs/adr/0004-watch-later-is-unreachable.md
#
# Found-or-created on first authorisation; the ID is then cached. Renaming this
# later makes Later find-or-create a *different* playlist — the old one is left
# alone, not migrated.
LATER_PLAYLIST_NAME=Later

# private | unlisted | public
# Defaults to private: what you intend to watch is nobody else's business.
LATER_PLAYLIST_PRIVACY=private


# -----------------------------------------------------------------------------
# Ingest authentication  [REQUIRED]
# -----------------------------------------------------------------------------

# [REQUIRED in SOLO] Shared secret for POST /api/ingest. Every client (iOS
# Shortcut, PWA, web paste box) sends it as `Authorization: Bearer <token>`.
#
# Without this, anyone who discovers your URL can fill your playlist.
#
# NOT USED IN MULTI. There, each account mints its own token from the web UI
# after connecting Google, and only a SHA-256 hash of it is ever stored. Later
# warns at startup if you set this in MULTI, because a secret that authenticates
# nothing is a secret somebody will eventually assume is doing something.
#
# Generate — never reuse a value from a tutorial or a screenshot:
#   openssl rand -base64 32 | tr '+/' '-_' | tr -d '='
INGEST_TOKEN=

# Optional hardening. When set, ingest requests must additionally carry an
# HMAC-SHA256 signature over the body. Leave EMPTY unless you know you want it:
# iOS Shortcuts cannot compute an HMAC, so setting this breaks the iOS client.
# Reasonable for a Telegram-only or PWA-only deployment.
# See docs/adr/0008-ingest-authentication.md
INGEST_HMAC_SECRET=

# Fixed-window rate limit per token. Far above any human's sharing rate.
INGEST_RATE_LIMIT_PER_MINUTE=30


# -----------------------------------------------------------------------------
# Google OAuth  [REQUIRED]
# -----------------------------------------------------------------------------
# From docs/ACTION-REQUIRED.md Batch 1, Step 7.

# [REQUIRED] Ends in .apps.googleusercontent.com
GOOGLE_CLIENT_ID=

# [REQUIRED] Starts with GOCSPX-
GOOGLE_CLIENT_SECRET=

# testing | production
#
# Tell Later which publishing status your OAuth consent screen has, because
# Google exposes no API for an app to read its own.
#
# `testing`  => Google REVOKES YOUR REFRESH TOKEN AFTER 7 DAYS and Later stops
#               working. Later will warn you constantly, and will notify you
#               with a re-auth link when it happens rather than dying quietly.
# `production` => tokens survive indefinitely. You click past one "unverified
#               app" warning during authorisation. This is the recommendation.
#
# See docs/adr/0005-token-lifecycle-and-reauth.md
GOOGLE_OAUTH_PUBLISHING_STATUS=testing


# -----------------------------------------------------------------------------
# Encryption and sessions  [REQUIRED]
# -----------------------------------------------------------------------------

# [REQUIRED] 32 bytes, base64. Encrypts Google refresh tokens at rest (AES-GCM).
#   openssl rand -base64 32
#
# LOSING THIS means every stored token becomes undecryptable and every user must
# re-authorise. CHANGING IT has the same effect. Back it up wherever you keep
# passwords. See SECURITY.md.
TOKEN_ENCRYPTION_KEY=

# [REQUIRED] Signs web UI session cookies and Telegram link codes, both of which
# are stateless HMACs over an account ID rather than rows in a table.
#   openssl rand -base64 32
#
# Rotating it signs everyone out and invalidates any outstanding link code.
# Nothing else breaks; no stored data depends on it.
SESSION_SECRET=


# -----------------------------------------------------------------------------
# YouTube API quota
# -----------------------------------------------------------------------------
#
# Your Google Cloud project gets 10,000 units/day, resetting at midnight
# Pacific Time. Costs are uneven and this drives the whole pipeline design:
#
#   videos.list ............ 1        playlistItems.insert ... 50
#   playlistItems.list ..... 1        playlists.insert ....... 50
#   playlists.list ......... 1        search.list ........... 100  <-- !
#
#   share WITH a YouTube link in the text ....  51 units
#   share needing a search .................. 151 units
#
# So ~190 linked shares/day, or ~65 that need searching. Plenty for one person.
# See docs/adr/0006-quota-strategy.md

# Later's own budget. Deliberately below Google's 10,000 to leave ~10% headroom
# for anything else using this project and for costs we've mis-modelled.
# On exhaustion, work is QUEUED for the next reset — never dropped.
YOUTUBE_DAILY_QUOTA_BUDGET=9000

# Where the quota day boundary falls. Google resets at midnight Pacific; using
# UTC would refill the budget at the wrong time by up to 8 hours.
YOUTUBE_QUOTA_RESET_TZ=America/Los_Angeles


# -----------------------------------------------------------------------------
# Resolution pipeline
# -----------------------------------------------------------------------------

# Below this confidence, an item is HELD for one-tap review instead of being
# added. Higher = fewer wrong videos, more items to confirm by hand.
# Tier 0 (a real URL in the text) always scores 1.0 and is never held.
# Never set this to 0 — a wrong video in your playlist costs more trust than a
# missing right one.
RESOLVE_CONFIDENCE_THRESHOLD=0.75

# Tier 1: resolve TikTok/Instagram shortlinks and read captions via their public
# oEmbed endpoints. Free, no API key, no quota. Leave on.
ENABLE_PLATFORM_METADATA=true

# Optional. Instagram oEmbed appears to no longer need a token (Meta reversed
# this in June 2026 — see docs/verification-log.md). Later tries tokenless
# first; a token here is only used if present, and may raise rate limits.
INSTAGRAM_OEMBED_TOKEN=

# Tier 3: read transcripts / on-screen text for recommendations that exist only
# in audio or burned-in text. Slow, expensive, off by default.
ENABLE_TRANSCRIPT_RESOLUTION=false


# -----------------------------------------------------------------------------
# LLM (Tier 2) — entirely optional
# -----------------------------------------------------------------------------
#
# Only used when a share has NO YouTube link and needs a caption like "that
# Veritasium video on why planes fly" turned into a search query.
#
# Later works fully with LLM_PROVIDER=none. Tier 0 handles most real shares.
#
# NOTE: Gemini cannot grant YouTube access — that needs OAuth, full stop. What
# it shares with YouTube is the Google Cloud PROJECT, not the auth model.
# See docs/adr/0009-llm-provider-and-the-gemini-question.md

# none | gemini | openai-compatible
LLM_PROVIDER=none

# LLM_PROVIDER=gemini. From Google AI Studio, or enable the Generative Language
# API in the same `later` project. Free tier, no card.
GEMINI_API_KEY=

# LLM_PROVIDER=openai-compatible. Works with OpenAI, OpenRouter, Ollama,
# LM Studio — anything speaking the chat-completions shape.
OPENAI_BASE_URL=
OPENAI_API_KEY=

# Model id. Defaults per provider: gemini-2.5-flash / gpt-4o-mini
LLM_MODEL=


# -----------------------------------------------------------------------------
# Notifications
# -----------------------------------------------------------------------------
#
# The ingest endpoint returns immediately, so a notification is how you learn
# what happened. Without any channel configured you'll only see results in the
# web UI, which is fine but easy to miss.
#
# The one message that really matters: "authorisation expired, tap to re-auth".
# See docs/adr/0010-notifications-telegram-primary.md

# From @BotFather (/newbot). The bot doubles as an ingress adapter — forward a
# Reel to it from any app on any OS, no install needed.
TELEGRAM_BOT_TOKEN=

# MANDATORY IN SOLO when TELEGRAM_BOT_TOKEN is set. Comma-separated numeric chat
# IDs allowed to talk to the bot. Your bot's username is discoverable, so without
# this a stranger could write to your playlist. Startup refuses to enable the
# bot without it. Send the bot /id to find your number.
#
# OPTIONAL IN MULTI. There, a chat proves which account it belongs to by sending
# `/link <code>` with a 15-minute signed code from the web UI, and an unlinked
# chat can do nothing else. Leave this empty to let new people link themselves;
# set it to also restrict *which* chats may even try.
TELEGRAM_ALLOWED_CHAT_IDS=

# Random string proving inbound webhook calls really came from Telegram.
#   openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=

# Any URL that accepts a JSON POST — ntfy, Discord, Slack, Home Assistant.
NOTIFY_WEBHOOK_URL=

# Notify on every successful add. Off by default: a tool that removes friction
# shouldn't add a notification per share. Failures and items needing review are
# always notified regardless of this setting.
NOTIFY_ON_SUCCESS=false


# -----------------------------------------------------------------------------
# Storage (self-host / Node path only)
# -----------------------------------------------------------------------------
# On Cloudflare Workers the D1 binding is configured in wrangler.jsonc and this
# is ignored. Docker mounts a volume here so your data survives a rebuild.
DATABASE_PATH=./data/later.db


# -----------------------------------------------------------------------------
# Development
# -----------------------------------------------------------------------------

# true => all outbound YouTube/oEmbed/LLM calls are served from recorded
# fixtures. No credentials needed, no network used, no quota spent. This is how
# the entire pipeline is developed and tested, and it's the fastest way to see
# what Later does before you set any of the above up.
USE_FIXTURES=false

# There is no telemetry in Later. No analytics, no phone-home, no opt-out
# needed — there is nothing to opt out of. Nothing about your usage leaves your
# deployment except the API calls to Google, and to Telegram if you enable it.
